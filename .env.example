HOST=0.0.0.0
PORT=8080
DATA_DIR=./data
# Required by the installer. Browser prompts for this password (username: admin).
APP_PASSWORD=change-me
MAX_UPLOAD_GB=12
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE=int8_float16
STT_CHUNK_SECONDS=300
LLAMA_MODEL=./models/Qwen3-8B-Q4_K_M.gguf
LLAMA_BIN=./vendor/llama.cpp/build/bin/llama-server
LLAMA_CONTEXT=4096
TTS_VOICE=Hải Đăng
MAX_SPEED=1.18
# file: finish each video; stage: prioritize STT, then translation, then TTS.
QUEUE_MODE=file
